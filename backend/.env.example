# Порт, на котором запускается backend API
PORT=4000

# Разрешённый origin для CORS (домен фронтенда). "*" — разрешить все (только для разработки)
ALLOWED_ORIGIN=*

# Overpass API (OpenStreetMap) — ключ не нужен, публичный сервер
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Сколько часов кэшировать ответ Overpass (водоёмы меняются редко)
OVERPASS_CACHE_TTL_HOURS=24

# Open-Meteo API — ключ не нужен, публичный сервер
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Сколько часов кэшировать погодные данные
WEATHER_CACHE_TTL_HOURS=2
